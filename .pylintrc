# ringmaster is deliberately one file: install.sh copies a single script to
# /usr/local/bin, so there is nothing to import from and nothing to split into.
# The length limit is raised rather than the design changed - but not removed,
# so unbounded growth still gets flagged.
[MAIN]
max-module-lines=1500

[BASIC]
# Test methods say what they check in their names; setUp/tearDown are fixtures.
no-docstring-rgx=^(_|test_|setUp|tearDown)
